# Copy to .env and fill in (from the Terraform `monkey_env` output). .env is gitignored.
# Auth itself is handled by `az login` / DefaultAzureCredential — NOT stored here.

SECLAB_PREFIX=seclab

# --- Azure (Phase 1) ---
SECLAB_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
SECLAB_AZURE_RESOURCE_GROUP=seclab-rg
SECLAB_AZURE_NSG=seclab-nsg
SECLAB_AZURE_STORAGE_ACCOUNT=seclabxxxxxx
# Object ID of a throwaway lab principal to over-privilege (RBAC injector). Optional.
SECLAB_AZURE_TEST_PRINCIPAL_ID=
SECLAB_AZURE_BROAD_ROLE=Contributor

# --- AWS (Phase 2) ---
SECLAB_AWS_REGION=eu-central-1
